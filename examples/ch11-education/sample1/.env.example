# ============================================================
# 牧童中学智慧教学平台后端配置
# 使用方法：复制本文件为 .env，填入你自己的密钥
#   cp .env.example .env
# 注意：app.py 未使用 python-dotenv，.env 需通过环境变量方式注入
#   export $(cat .env | xargs) && python app.py
# ============================================================

# 服务端口（默认 1002）
PORT=1002

# 登录会话密钥（演示用，提交前建议修改）
SECRET_KEY=mutong-edu-demo

# 主观题 LLM 评分置信度阈值：低于此值转人工复核队列
CONF_THRESHOLD=0.7

# Agent 网关（统一 LLM 出口；未启动时自动走离线启发式降级）
GATEWAY_URL=http://127.0.0.1:10050
GATEWAY_MODEL=qwen-max

# ── 作业图片 OCR 供应商（三选一，未配置密钥的供应商自动降级为演示文本） ──
# 默认供应商：bailian / coze / dify
OCR_PROVIDER=bailian

# 百炼（阿里云 DashScope · qwen-vl 视觉模型，OpenAI 兼容协议）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-vl-max

# 扣子（Coze · Bot 对话 API，图片走 object_string 多模态消息）
COZE_API_TOKEN=
COZE_BOT_ID=

# Dify（应用 Chat API，files 传 base64 图片；应用需启用视觉模型）
DIFY_API_KEY=
DIFY_BASE_URL=http://127.0.0.1:8080
