# ============================================================
# 牧童 · 物料看板后端配置
# 使用方法：复制本文件为 .env，填入你自己的密钥
#   cp .env.example .env
# ============================================================

# 服务端口（默认 1001）
PORT=1001

# 登录认证（演示账号，建议提交前修改）
SECRET_KEY=mutong-mes-demo
DEMO_USERNAME=admin
DEMO_PASSWORD=123456

# 百炼（云端大模型；不填则分析接口返回 mock 兜底结果）
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen-plus

# 牧童 Agent（企业自建 Agent 网关，OpenAI 兼容接口；不填则跳过该通道）
MUTONG_AGENT_URL=
MUTONG_AGENT_KEY=

# DeepSeek（推理模型；不填则返回 mock 兜底结果）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# 飞书（HITL 审批卡片推送；不填则仅页面审批，不推送卡片）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=
