# ============================================================
# 牧童商城 · 电商智慧运营平台后端配置
# 使用方法：复制本文件为 .env，填入你自己的密钥
#   cp .env.example .env
# 注意：app.py 未使用 python-dotenv，.env 需通过环境变量方式注入
#   export $(cat .env | xargs) && python app.py
# ============================================================

# 服务端口（默认 1003）
PORT=1003

# 登录会话密钥（演示用，提交前建议修改）
SECRET_KEY=mutong-mall-demo

# 推荐置信度阈值：低于此值转人工审核
CONF_THRESHOLD=0.7

# Agent 网关（统一 LLM 出口；未启动时自动走离线启发式降级）
GATEWAY_URL=http://127.0.0.1:10050
GATEWAY_MODEL=qwen-max
